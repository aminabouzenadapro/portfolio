{
    "name": "aminabouzenada/clinic-booking",
    "description": "Appointment booking for a medical center in Constantine: PHP 8 API on MySQL",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "psr-4": { "Clinic\\": "src/" },
        "files": ["src/bootstrap.php"]
    },
    "autoload-dev": {
        "psr-4": { "Clinic\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8200 -t public"
    },
    "config": {
        "sort-packages": true
    }
}
