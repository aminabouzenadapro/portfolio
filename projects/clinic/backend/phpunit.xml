<?xml version="1.0" encoding="UTF-8"?>
<!-- Tests use SQLite in memory by default. To run them on MySQL/MariaDB:
     TEST_DATABASE_URL=mysql://user:pass@127.0.0.1:3306/clinic_test vendor/bin/phpunit -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="clinic">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
